  brutoDocumentAmount Decimal          @default(0) @db.Decimal(18, 2)
  nilaiJual           Decimal          @default(0) @db.Decimal(18, 2)
  dppPb1              Decimal          @default(0) @db.Decimal(18, 2)
  dppPpn              Decimal          @default(0) @db.Decimal(18, 2)
  dppPph              Decimal          @default(0) @db.Decimal(18, 2)
  ppnAmount           Decimal          @default(0) @db.Decimal(18, 2)
  pph42Amount         Decimal          @default(0) @db.Decimal(18, 2)
  pph23Amount         Decimal          @default(0) @db.Decimal(18, 2)
  pph23Rate15Amount   Decimal          @default(0) @db.Decimal(18, 2)
  pph21Amount         Decimal          @default(0) @db.Decimal(18, 2)
  pb1Amount           Decimal          @default(0) @db.Decimal(18, 2)
  grossAmount         Decimal          @db.Decimal(18, 2)
  feeAmount           Decimal          @default(0) @db.Decimal(18, 2)
  netAmount           Decimal          @db.Decimal(18, 2)
  overpaymentAmount   Decimal          @default(0) @db.Decimal(18, 2)
  refundBankName      String?
  refundAccountNumber String?
  refundAccountHolder String?
  withholdingSlipNo   String?
