model Refund {
  id                String          @id @default(uuid())
  refundNumber      String          @unique
  paymentId         String
  payment           Payment         @relation(fields: [paymentId], references: [id])
  customerInvoiceId String
  customerInvoice   CustomerInvoice @relation(fields: [customerInvoiceId], references: [id])
  amount            Decimal         @db.Decimal(18, 2)
  reason            String
  status            String          @default("PROCESSED")
  requestedById     String
  requestedByName   String
  approvedById      String?
  processedAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
}

model CashRegister {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  isActive       Boolean      @default(true)

  sessions CashierSession[]
}

model CashierSession {
  id                 String       @id @default(uuid())
  sessionNumber      String       @unique
  cashRegisterId     String
  cashRegister       CashRegister @relation(fields: [cashRegisterId], references: [id])
  businessUnitId     String
  businessUnit       BusinessUnit @relation(fields: [businessUnitId], references: [id])
  cashierId          String
  cashierName        String
  openedAt           DateTime     @default(now())
  openingFloat       Decimal      @db.Decimal(18, 2)
  totalCashIn        Decimal      @default(0) @db.Decimal(18, 2)
  totalCashOut       Decimal      @default(0) @db.Decimal(18, 2)
  theoreticalBalance Decimal      @db.Decimal(18, 2)
  actualCountedCash  Decimal?     @db.Decimal(18, 2)
  discrepancyAmount  Decimal?     @db.Decimal(18, 2)
  discrepancyReason  String?
  status             String       @default("OPEN")
  closedAt           DateTime?
  reviewedById       String?
  reviewedByName     String?
  reviewedAt         DateTime?
  reviewNote         String?
  isDemoData         Boolean      @default(true)

  payments Payment[]
  deposits CashDeposit[]
}

model CashDeposit {
  id               String         @id @default(uuid())
  depositNumber    String         @unique
  cashierSessionId String
  cashierSession   CashierSession @relation(fields: [cashierSessionId], references: [id])
  bankAccountId    String
  bankAccount      BankAccount    @relation(fields: [bankAccountId], references: [id])
  depositDate      DateTime       @default(now())
  amount           Decimal        @db.Decimal(18, 2)
  referenceNo      String
  depositedById    String
  depositedByName  String
  status           String         @default("VERIFIED")
  notes            String?
  createdAt        DateTime       @default(now())
}

model BankAccount {
  id                  String       @id @default(uuid())
  code                String       @unique
  bankName            String
  accountNumberMasked String
  accountHolder       String
  businessUnitId      String
  businessUnit        BusinessUnit @relation(fields: [businessUnitId], references: [id])
  glAccountCode       String       @default("1-1120")
  currentBalance      Decimal      @default(0) @db.Decimal(18, 2)
  currency            String       @default("IDR")
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())

  payments         Payment[]
  deposits         CashDeposit[]
  statementImports BankStatementImport[]
  statementLines   BankStatementLine[]
}

model BankStatementImport {
  id             String      @id @default(uuid())
  importNumber   String      @unique
  bankAccountId  String
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id])
  periodLabel    String
  fileName       String
  totalLines     Int
  matchedCount   Int         @default(0)
  unmatchedCount Int         @default(0)
  duplicateCount Int         @default(0)
  status         String      @default("RECONCILING")
  importedById   String
  importedByName String
  finalizedById  String?
  finalizedAt    DateTime?
  createdAt      DateTime    @default(now())

  lines BankStatementLine[]
}

model BankStatementLine {
  id                String              @id @default(uuid())
  importId          String
  statementImport   BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  bankAccountId     String
  bankAccount       BankAccount         @relation(fields: [bankAccountId], references: [id])
  transactionDate   DateTime
  description       String
  referenceNo       String
  direction         String
  amount            Decimal             @db.Decimal(18, 2)
  runningBalance    Decimal?            @db.Decimal(18, 2)
  fingerprint       String              @unique
  matchStatus       String              @default("UNMATCHED")
  matchedEntityType String?
  matchedEntityId   String?
  matchedDocNumber  String?
  exceptionNote     String?
  reconciledById    String?
  reconciledByName  String?
  reconciledAt      DateTime?
}

model ChartOfAccount {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  type              String
  normalBalance     String
  parentCode        String?
  isControlAccount  Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  journalLines JournalLine[]
}

model AccountMapping {
  id                String   @id @default(uuid())
  transactionType   String   @unique
  description       String
  debitAccountCode  String
  creditAccountCode String
  updatedAt         DateTime @updatedAt
}

model JournalEntry {
  id              String       @id @default(uuid())
  journalNumber   String       @unique
  entryDate       DateTime
  fiscalPeriodId  String
  fiscalPeriod    FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  businessUnitId  String
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id])
  sourceType      String
  sourceId        String?
  sourceDocNumber String?
  idempotencyKey  String       @unique
  description     String
  totalDebit      Decimal      @db.Decimal(18, 2)
  totalCredit     Decimal      @db.Decimal(18, 2)
  status          String       @default("POSTED")
  reversedFromId  String?
  reversalReason  String?
  createdById     String
  createdByName   String
  postedById      String?
  postedAt        DateTime?
  isDemoData      Boolean      @default(true)
  createdAt       DateTime     @default(now())

  lines               JournalLine[]
  assetDepreciations  AssetDepreciation[]

  @@index([fiscalPeriodId, status])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id             String         @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  account        ChartOfAccount @relation(fields: [accountCode], references: [code])
  costCenterId   String?
  costCenter     CostCenter?    @relation(fields: [costCenterId], references: [id])
  description    String
  debit          Decimal        @default(0) @db.Decimal(18, 2)
  credit         Decimal        @default(0) @db.Decimal(18, 2)

  @@index([accountCode])
}

model TaxConfiguration {
  id            String    @id @default(uuid())
  taxCode       String    @unique
  name          String
  taxType       String
  ratePercent   Decimal   @db.Decimal(5, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  version       Int       @default(1)
  isInclusive   Boolean   @default(false)
  isActive      Boolean   @default(true)
  notes         String?
}

model FixedAsset {
  id                      String       @id @default(uuid())
  assetCode               String       @unique
  name                    String
  category                String
  businessUnitId          String
  businessUnit            BusinessUnit @relation(fields: [businessUnitId], references: [id])
  ownershipStatus         String       @default("PMO_OWNED") // PMO_OWNED, PBI_UT_LOAN, RENTAL, EXTERNAL_LOAN
  lenderName              String?      // e.g. "Pusat Bisnis dan Investasi (PBI) Universitas Terbuka"
  loanDocNumber           String?      // Nomor BAST / Surat Peminjaman
  loanDate                DateTime?
  loanReturnDate          DateTime?
  picPerson               String?      @default("Mas Wildan")
  brandModel              String?
  serialNumber            String?
  condition               String       @default("GOOD") // GOOD, NEEDS_REPAIR, DAMAGED
  acquisitionDate         DateTime
  acquisitionCost         Decimal      @db.Decimal(18, 2)
  salvageValue            Decimal      @default(0) @db.Decimal(18, 2)
  usefulLifeMonths        Int          @default(48) // e.g. 4 tahun = 48 bulan
  usefulLifeYears         Int          @default(4)
  depreciationMethod      String       @default("STRAIGHT_LINE")
  accumulatedDepreciation Decimal      @default(0) @db.Decimal(18, 2)
  bookValue               Decimal      @db.Decimal(18, 2)
  location                String
  status                  String       @default("ACTIVE")
  policyApproved          Boolean      @default(true)
  notes                   String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @default(now()) @updatedAt

  expenditures   AssetExpenditure[]
  depreciations  AssetDepreciation[]

  @@index([businessUnitId, ownershipStatus])
}

model AssetDepreciation {
  id                  String       @id @default(uuid())
  assetId             String
  asset               FixedAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodYear          Int
  periodMonth         Int
  depreciationDate    DateTime     @db.Date
  cutoffApplied       Boolean      @default(true)
  acquisitionDate     DateTime     @db.Date
  depreciableCost     Decimal      @db.Decimal(18, 2)
  monthlyDepreciation Decimal      @db.Decimal(18, 2)
  priorAccumulated    Decimal      @db.Decimal(18, 2)
  depreciationAmount  Decimal      @db.Decimal(18, 2)
  endingAccumulated   Decimal      @db.Decimal(18, 2)
  endingBookValue     Decimal      @db.Decimal(18, 2)
  journalEntryId      String?
  journalEntry        JournalEntry? @relation(fields: [journalEntryId], references: [id])
  coaDebit            String       @default("520901030100")
  coaCredit           String       @default("120307020100")
  status              String       @default("POSTED")
  notes               String?
  createdAt           DateTime     @default(now())

  @@unique([assetId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

model AssetExpenditure {
  id                  String     @id @default(uuid())
  expenditureNumber   String     @unique // e.g. "EXP-AST/2026/12/001"
  assetId             String
  asset               FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transactionDate     DateTime   @db.Date
  description         String
  amount              Decimal    @db.Decimal(18, 2)
  currentBookValue    Decimal    @db.Decimal(18, 2)
  ratioPercent        Decimal    @db.Decimal(8, 2)
  isCapitalized       Boolean
  accountingTreatment String     // CAPITALIZED_TO_ASSET or EXPENSED_TO_MAINTENANCE
  coaDebit            String
  coaCredit           String     @default("110102010300")
  additionalMonths    Int        @default(0)
  vendorName          String?
  invoiceDocNumber    String?
  approvedBy          String?
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now()) @updatedAt

  @@index([assetId, isCapitalized])
}

model StrategicEvaluation {
  id                       String       @id @default(uuid())
  evalNumber               String       @unique
  fiscalPeriodId           String
  fiscalPeriod             FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  businessUnitId           String
  businessUnit             BusinessUnit @relation(fields: [businessUnitId], references: [id])
  targetRevenue            Decimal      @db.Decimal(18, 2)
  actualRevenue            Decimal      @db.Decimal(18, 2)
  budgetCeiling            Decimal      @db.Decimal(18, 2)
  actualExpense            Decimal      @db.Decimal(18, 2)
  netCashflow              Decimal      @db.Decimal(18, 2)
  varianceAnalysis         String
  riskSummary              String
  recommendedNextCeiling   Decimal      @db.Decimal(18, 2)
  recommendedRevenueTarget Decimal      @db.Decimal(18, 2)
  gmDecision               String       @default("PENDING")
  gmDecisionNote           String?
  decidedById              String?
  decidedByName            String?
  decidedAt                DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

model PettyCashSubmission {
  id                  String            @id @default(uuid())
  submissionNo        String            @unique
  type                String            @default("GUP") // GUP or TUP_NIHIL
  year                Int               @default(2026)
  businessUnitId      String?
  businessUnit        BusinessUnit?     @relation(fields: [businessUnitId], references: [id])
  applicantName       String
  applicantUnit       String
  applicantPhone      String
  expenseCategory     String
  draUkCode           String
  draUkName           String
  coaCode             String
  coaName             String
  activityDescription String
  vendorId            String?
  vendor              Vendor?           @relation(fields: [vendorId], references: [id])
  vendorName          String
  vendorTaxId         String
  vendorIdentityName  String
  isSaveVendor        Boolean           @default(false)
  transactionDate     DateTime
  paymentMethod       String            @default("TRANSFER_BANK")
  transactionType     String            @default("Transaksi Baru")
  territoryType       String            @default("Dalam Negeri")
  totalTransaction    Decimal           @db.Decimal(18, 2)
  nonTaxableAmount    Decimal           @default(0) @db.Decimal(18, 2)
  taxableAmount       Decimal           @default(0) @db.Decimal(18, 2)
  taxType             String
  taxDetail           String
  dppPpn              Decimal           @default(0) @db.Decimal(18, 2)
  dppPph              Decimal           @default(0) @db.Decimal(18, 2)
  taxRatePercent      Decimal           @default(0) @db.Decimal(5, 2)
  pphAmount           Decimal           @default(0) @db.Decimal(18, 2)
  ppnAmount           Decimal           @default(0) @db.Decimal(18, 2)
  netDisbursement     Decimal           @default(0) @db.Decimal(18, 2)
  taxFormulas         Json?
  invoiceDocNo        String
  invoiceDocDate      DateTime
  invoiceDocFile      String?
  receiptUtDocNo      String?
  receiptUtDocDate    DateTime?
  receiptUtDocFile    String?
  status              String            @default("SUBMITTED") // DRAFT, SUBMITTED, TAX_VERIFIED, APPROVED, DISBURSED, REJECTED
  rejectionReason     String?
  verifiedTaxBy       String?
  verifiedTaxAt       DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  disbursedAt         DateTime?
  journalEntryId      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               PettyCashItem[]

  @@index([businessUnitId, status])
  @@index([type, status])
}

model PettyCashItem {
  id           String              @id @default(uuid())
  submissionId String
  submission   PettyCashSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  description  String
  unit         String
  quantity     Int
  unitPrice    Decimal             @db.Decimal(18, 2)
  totalPrice   Decimal             @db.Decimal(18, 2)
  isTaxable    Boolean             @default(true)
}

model Employee {
  id                     String       @id @default(uuid())
  nip                    String       @unique // e.g. "PMO-2026-001"
  nik                    String       // NIK KTP 16 digit
  fullName               String
  email                  String?
  phone                  String?
  businessUnitId         String?
  businessUnit           BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  department             String       // e.g. "Divisi MICE", "Divisi TCI", "Operasional PMO"
  position               String       // e.g. "Event Coordinator", "Instruktur Pelatihan", "Staff Keuangan"
  employmentStatus       String       @default("PERMANENT") // PERMANENT, CONTRACT, INTERN, PART_TIME
  joinDate               DateTime
  baseSalary             Decimal      @default(0) @db.Decimal(18, 2)
  positionAllowance      Decimal      @default(0) @db.Decimal(18, 2)
  transportAllowance     Decimal      @default(0) @db.Decimal(18, 2)
  bankName               String       @default("Bank Mandiri")
  bankAccountNo          String?
  bankAccountHolder      String?
  npwp                   String?
  bpjsKesehatanNo        String?
  bpjsKetenagakerjaanNo  String?
  status                 String       @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @default(now()) @updatedAt

  attendances Attendance[]
  salarySlips SalarySlip[]
  contracts   EmployeeContract[]

  @@index([businessUnitId, department, status])
}

model EmployeeContract {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractNumber String    // e.g. "SK/PMO/PUT-PK/2026/014"
  contractType   String    @default("PUT_PK") // PUT_PK, PKWT, KONSULTAN_AHLI, MAGANG
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  salaryRate     Decimal?  @db.Decimal(18, 2)
  status         String    @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, RENEWED, TERMINATED
  notes          String?
  signedDate     DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([employeeId, status])
  @@index([endDate, status])
}

model Attendance {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  status        String    @default("PRESENT") // PRESENT, LATE, SICK, LEAVE, ALPHA
  overtimeHours Decimal   @default(0) @db.Decimal(5, 2)
  notes         String?
  verifiedBy    String?
  createdAt     DateTime  @default(now())

  @@unique([employeeId, date])
  @@index([date, status])
}

model SalarySlip {
  id                String    @id @default(uuid())
  slipNumber        String    @unique // e.g. "PAY/PMO/2026/10/001"
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id])
  periodMonth       Int
  periodYear        Int
  baseSalary        Decimal   @db.Decimal(18, 2)
  allowanceTotal    Decimal   @default(0) @db.Decimal(18, 2)
  overtimeAmount    Decimal   @default(0) @db.Decimal(18, 2)
  deductionAbsence  Decimal   @default(0) @db.Decimal(18, 2)
  deductionBpjs     Decimal   @default(0) @db.Decimal(18, 2)
  deductionPph21    Decimal   @default(0) @db.Decimal(18, 2)
  grossSalary       Decimal   @db.Decimal(18, 2)
  netSalary         Decimal   @db.Decimal(18, 2)
  status            String    @default("DRAFT") // DRAFT, APPROVED, PAID
  paymentDate       DateTime?
  paymentMethod     String    @default("TRANSFER_BANK")
  journalNumber     String?
  notes             String?
  createdAt         DateTime  @default(now())

  @@index([periodYear, periodMonth, status])
}

model HrisPeriodLock {
  id             String    @id @default(uuid())
  periodMonth    Int
  periodYear     Int
  businessUnitId String    @default("GLOBAL")
  isLocked       Boolean   @default(true)
  cutoffDate     DateTime  @db.Date
  cutoffTime     String    @default("23:59:59")
  lockedAt       DateTime  @default(now())
  unlockedAt     DateTime?
  unlockedBy     String?
  unlockReason   String?
  unlockedUntil  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@unique([periodYear, periodMonth, businessUnitId])
  @@index([periodYear, periodMonth, isLocked])
}



