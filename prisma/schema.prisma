generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusinessUnit {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  type        String   @default("OPERATIONAL")
  managerName String
  isActive    Boolean  @default(true)
  isDemoData  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  costCenters          CostCenter[]
  users                User[]
  budgets              Budget[]
  purchaseRequests     PurchaseRequest[]
  purchaseOrders       PurchaseOrder[]
  vendorInvoices       VendorInvoice[]
  expenses             Expense[]
  productServices      ProductService[]
  salesOrders          SalesOrder[]
  customerInvoices     CustomerInvoice[]
  payments             Payment[]
  cashRegisters        CashRegister[]
  cashierSessions      CashierSession[]
  bankAccounts         BankAccount[]
  journalEntries       JournalEntry[]
  fixedAssets          FixedAsset[]
  strategicEvaluations StrategicEvaluation[]
  pettyCashSubmissions PettyCashSubmission[]
  employees            Employee[]
}

model CostCenter {
  id             String       @id @default(uuid())
  code           String       @unique
  name           String
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  budgetLines      BudgetLine[]
  purchaseRequests PurchaseRequest[]
  expenses         Expense[]
  journalLines     JournalLine[]
}

model FundSource {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  type        String   @default("INTERNAL_ALLOCATION")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  budgets  Budget[]
  expenses Expense[]
}

model FiscalPeriod {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  startDate    DateTime
  endDate      DateTime
  status       String    @default("OPEN")
  isClosed     Boolean   @default(false)
  closedAt     DateTime?
  closedById   String?
  reopenReason String?
  createdAt    DateTime  @default(now())

  budgets              Budget[]
  journalEntries       JournalEntry[]
  strategicEvaluations StrategicEvaluation[]
}

model Role {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String
  permissions   String[]
  approvalLimit Decimal  @default(0) @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  users User[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  fullName       String
  passwordHash   String
  roleCode       String
  role           Role          @relation(fields: [roleCode], references: [code])
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  isActive       Boolean       @default(true)
  isDemoData     Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ApprovalPolicy {
  id                        String   @id @default(uuid())
  module                    String
  name                      String
  minAmount                 Decimal  @db.Decimal(18, 2)
  maxAmount                 Decimal? @db.Decimal(18, 2)
  requiredRoleCode          String
  minQuotations             Int      @default(3)
  requireSeparationOfDuties Boolean  @default(true)
  isActive                  Boolean  @default(true)
  createdAt                 DateTime @default(now())
}

model ApprovalRequest {
  id               String    @id @default(uuid())
  requestNumber    String    @unique
  module           String
  entityId         String
  entityCode       String
  title            String
  businessUnitId   String?
  amount           Decimal   @db.Decimal(18, 2)
  status           String    @default("PENDING")
  requestedById    String
  requestedByName  String
  requiredRoleCode String
  decidedById      String?
  decidedByName    String?
  decidedAt        DateTime?
  decisionNote     String?
  exceptionReason  String?
  createdAt        DateTime  @default(now())

  @@index([status, requiredRoleCode])
  @@index([module, entityId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String
  actorRole  String
  action     String
  module     String
  entityType String
  entityId   String
  entityCode String?
  summary    String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([module, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String?
  roleCode   String?
  title      String
  message    String
  category   String
  severity   String   @default("INFO")
  targetUrl  String
  entityType String
  entityId   String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([roleCode, isRead])
}

model FileAttachment {
  id                 String   @id @default(uuid())
  displayName        String
  storageKey         String   @unique
  mimeType           String
  sizeBytes          Int
  module             String
  entityId           String
  documentType       String
  verificationStatus String   @default("VERIFIED")
  uploadedById       String
  uploadedByName     String
  createdAt          DateTime @default(now())

  @@index([module, entityId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  description String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Budget {
  id              String       @id @default(uuid())
  docNumber       String       @unique
  title           String
  businessUnitId  String
  businessUnit    BusinessUnit @relation(fields: [businessUnitId], references: [id])
  fiscalPeriodId  String
  fiscalPeriod    FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  fundSourceId    String
  fundSource      FundSource   @relation(fields: [fundSourceId], references: [id])
  version         Int          @default(1)
  status          String       @default("DRAFT")
  totalAllocated  Decimal      @default(0) @db.Decimal(18, 2)
  totalCommitted  Decimal      @default(0) @db.Decimal(18, 2)
  totalActual     Decimal      @default(0) @db.Decimal(18, 2)
  revenueTarget   Decimal      @default(0) @db.Decimal(18, 2)
  notes           String?
  rejectionReason String?
  createdById     String
  createdByName   String
  submittedAt     DateTime?
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  isDemoData      Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  lines     BudgetLine[]
  revisions BudgetRevision[]

  @@index([businessUnitId, fiscalPeriodId, status])
}

model BudgetLine {
  id              String     @id @default(uuid())
  budgetId        String
  budget          Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  costCenterId    String
  costCenter      CostCenter @relation(fields: [costCenterId], references: [id])
  accountCode     String
  category        String
  description     String
  allocatedAmount Decimal    @db.Decimal(18, 2)
  committedAmount Decimal    @default(0) @db.Decimal(18, 2)
  actualAmount    Decimal    @default(0) @db.Decimal(18, 2)

  // Multi-Volume & Semula-Menjadi Pergeseran Fields (Pertor 310 & Format Rektorat)
  activityCode      String?
  activityName      String?
  subActivity       String?
  detailDescription String?
  kelompokPagu      String?    @default("Layanan Dasar")
  fte               String?
  vol1              Decimal?   @default(1) @db.Decimal(10, 2)
  satuan1           String?    @default("Unit")
  vol2              Decimal?   @default(1) @db.Decimal(10, 2)
  satuan2           String?
  vol3              Decimal?   @default(1) @db.Decimal(10, 2)
  satuan3           String?
  vol4              Decimal?   @default(1) @db.Decimal(10, 2)
  satuan4           String?
  totalVolume       Decimal?   @default(1) @db.Decimal(12, 2)
  unitPrice         Decimal?   @default(0) @db.Decimal(18, 2)
  semulaAmount      Decimal?   @default(0) @db.Decimal(18, 2)
  pergeseranAmount  Decimal?   @default(0) @db.Decimal(18, 2)
  menjadiAmount     Decimal?   @default(0) @db.Decimal(18, 2)
  alasanRevisi      String?

  commitments      BudgetCommitment[]
  purchaseRequests PurchaseRequest[]
  expenses         Expense[]
}

model BudgetRevision {
  id                String   @id @default(uuid())
  budgetId          String
  budget            Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  version           Int
  reason            String
  previousAllocated Decimal  @db.Decimal(18, 2)
  newAllocated      Decimal  @db.Decimal(18, 2)
  snapshotData      Json
  revisedById       String
  revisedByName     String
  approvedById      String?
  status            String   @default("APPROVED")
  createdAt         DateTime @default(now())
}

model BudgetCommitment {
  id               String     @id @default(uuid())
  budgetLineId     String
  budgetLine       BudgetLine @relation(fields: [budgetLineId], references: [id])
  sourceType       String
  sourceId         String
  sourceDocNumber  String
  amount           Decimal    @db.Decimal(18, 2)
  status           String     @default("RESERVED")
  createdAt        DateTime   @default(now())

  @@index([sourceType, sourceId])
}

model Vendor {
  id                    String   @id @default(uuid())
  code                  String   @unique
  name                  String
  legalName             String
  taxIdNpwp             String   @unique
  category              String
  contactName           String
  email                 String
  phone                 String
  address               String
  bankName              String
  bankAccountNo         String
  bankAccountHolder     String
  completenessScore     Int      @default(100)
  hasConflictOfInterest Boolean  @default(false)
  conflictNote          String?
  evaluationRating      Decimal  @default(4.50) @db.Decimal(3, 2)
  evaluationNote        String?
  status                String   @default("ACTIVE")
  isDemoData            Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  quotations     VendorQuotation[]
  purchaseOrders PurchaseOrder[]
  vendorInvoices VendorInvoice[]
  expenses       Expense[]
  pettyCashSubmissions PettyCashSubmission[]
}

model PurchaseRequest {
  id                       String       @id @default(uuid())
  docNumber                String       @unique
  title                    String
  businessUnitId           String
  businessUnit             BusinessUnit @relation(fields: [businessUnitId], references: [id])
  costCenterId             String
  costCenter               CostCenter   @relation(fields: [costCenterId], references: [id])
  budgetLineId             String
  budgetLine               BudgetLine   @relation(fields: [budgetLineId], references: [id])
  purpose                  String
  estimatedTotal           Decimal      @db.Decimal(18, 2)
  status                   String       @default("DRAFT")
  minQuotationsRequired    Int          @default(3)
  quotationExceptionReason String?
  rejectionReason          String?
  requestedById            String
  requestedByName          String
  approvedById             String?
  approvedByName           String?
  approvedAt               DateTime?
  isDemoData               Boolean      @default(true)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  lines          PurchaseRequestLine[]
  quotations     VendorQuotation[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseRequestLine {
  id                 String          @id @default(uuid())
  purchaseRequestId  String
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  itemName           String
  specification      String?
  quantity           Decimal         @db.Decimal(12, 2)
  unit               String
  estimatedUnitPrice Decimal         @db.Decimal(18, 2)
  lineTotal          Decimal         @db.Decimal(18, 2)
}

model VendorQuotation {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  vendorId          String
  vendor            Vendor          @relation(fields: [vendorId], references: [id])
  quotationNumber   String
  quotedSubtotal    Decimal         @db.Decimal(18, 2)
  taxAmount         Decimal         @db.Decimal(18, 2)
  totalAmount       Decimal         @db.Decimal(18, 2)
  deliveryDays      Int
  warrantyInfo      String?
  documentComplete  Boolean         @default(true)
  isSelected        Boolean         @default(false)
  selectionReason   String?
  notes             String?
  createdAt         DateTime        @default(now())
}

model PurchaseOrder {
  id                     String          @id @default(uuid())
  docNumber              String          @unique
  purchaseRequestId      String
  purchaseRequest        PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  vendorId               String
  vendor                 Vendor          @relation(fields: [vendorId], references: [id])
  businessUnitId         String
  businessUnit           BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  selectedQuotationId    String?
  orderDate              DateTime        @default(now())
  expectedDeliveryDate   DateTime
  paymentTerms           String          @default("NET 30")
  subtotal               Decimal         @db.Decimal(18, 2)
  discountAmount         Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount              Decimal         @db.Decimal(18, 2)
  totalAmount            Decimal         @db.Decimal(18, 2)
  status                 String          @default("APPROVED")
  selectionJustification String
  cancellationReason     String?
  createdById            String
  createdByName          String
  approvedById           String?
  approvedAt             DateTime?
  isDemoData             Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  lines          PurchaseOrderLine[]
  goodsReceipts  GoodsReceipt[]
  vendorInvoices VendorInvoice[]
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName         String
  quantity         Decimal       @db.Decimal(12, 2)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 2)
  invoicedQuantity Decimal       @default(0) @db.Decimal(12, 2)
  unit             String
  unitPrice        Decimal       @db.Decimal(18, 2)
  lineTotal        Decimal       @db.Decimal(18, 2)
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  docNumber       String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedDate    DateTime      @default(now())
  receivedById    String
  receivedByName  String
  conditionNote   String?
  deliveryNoteRef String
  status          String        @default("COMPLETE")
  createdAt       DateTime      @default(now())

  lines GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id                  String       @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  itemName            String
  quantityReceived    Decimal      @db.Decimal(12, 2)
  condition           String       @default("GOOD")
}

model VendorInvoice {
  id                  String         @id @default(uuid())
  internalNumber      String         @unique
  vendorInvoiceNumber String
  vendorId            String
  vendor              Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  businessUnitId      String
  businessUnit        BusinessUnit   @relation(fields: [businessUnitId], references: [id])
  invoiceDate         DateTime
  dueDate             DateTime
  subtotal            Decimal        @db.Decimal(18, 2)
  taxAmount           Decimal        @db.Decimal(18, 2)
  totalAmount         Decimal        @db.Decimal(18, 2)
  paidAmount          Decimal        @default(0) @db.Decimal(18, 2)
  matchingStatus      String         @default("MATCHED_3WAY")
  matchingNote        String?
  status              String         @default("VERIFIED")
  createdById         String
  verifiedById        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  expenses Expense[]

  @@unique([vendorId, vendorInvoiceNumber])
}

model Expense {
  id              String         @id @default(uuid())
  docNumber       String         @unique
  title           String
  businessUnitId  String
  businessUnit    BusinessUnit   @relation(fields: [businessUnitId], references: [id])
  costCenterId    String
  costCenter      CostCenter     @relation(fields: [costCenterId], references: [id])
  budgetLineId    String
  budgetLine      BudgetLine     @relation(fields: [budgetLineId], references: [id])
  fundSourceId    String
  fundSource      FundSource     @relation(fields: [fundSourceId], references: [id])
  vendorId        String?
  vendor          Vendor?        @relation(fields: [vendorId], references: [id])
  vendorInvoiceId String?
  vendorInvoice   VendorInvoice? @relation(fields: [vendorInvoiceId], references: [id])
  category        String
  paymentMethod   String         @default("BANK_TRANSFER")
  recipientName   String
  transactionDate DateTime
  subtotal        Decimal        @db.Decimal(18, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(18, 2)
  totalAmount     Decimal        @db.Decimal(18, 2)
  description     String
  receiptRef      String?
  status          String         @default("DRAFT")
  rejectionReason String?
  voidReason      String?
  journalEntryId  String?
  createdById     String
  createdByName   String
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  paidAt          DateTime?
  isDemoData      Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Customer {
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  organizationType    String   @default("CORPORATE")
  taxCollectorProfile String   @default("FP_040_UMUM")
  taxIdNpwp           String?
  contactPerson       String
  email               String
  phone               String
  address             String
  creditLimit         Decimal  @default(100000000) @db.Decimal(18, 2)
  status              String   @default("ACTIVE")
  isDemoData          Boolean  @default(true)
  createdAt           DateTime @default(now())

  salesOrders      SalesOrder[]
  customerInvoices CustomerInvoice[]
  payments         Payment[]
}

model ProductService {
  id                 String       @id @default(uuid())
  sku                String       @unique
  name               String
  category           String
  location           String?
  businessUnitId     String
  businessUnit       BusinessUnit @relation(fields: [businessUnitId], references: [id])
  unitPrice          Decimal      @db.Decimal(18, 2)
  unit               String       @default("Paket")
  taxCode            String       @default("PPN-11")
  taxScheme          String       @default("PPN12_PMK131")
  taxInclusive       Boolean      @default(true)
  revenueAccountCode String       @default("4-1100")
  overtimeNote       String?
  freeFacilities     String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  priceHistories  ProductPriceHistory[]
  salesOrderLines SalesOrderLine[]
}

model ProductPriceHistory {
  id               String         @id @default(uuid())
  productServiceId String
  productService   ProductService @relation(fields: [productServiceId], references: [id], onDelete: Cascade)
  oldPrice         Decimal        @db.Decimal(18, 2)
  newPrice         Decimal        @db.Decimal(18, 2)
  changedById      String
  changedByName    String
  reason           String
  changedAt        DateTime       @default(now())
}

model SalesOrder {
  id             String       @id @default(uuid())
  docNumber      String       @unique
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  businessUnitId String
  businessUnit   BusinessUnit @relation(fields: [businessUnitId], references: [id])
  activityTitle  String?
  activityDate   String?
  contractRef    String?
  orderDate      DateTime     @default(now())
  dueDate        DateTime
  terms          String       @default("NET 14")
  subtotal             Decimal      @db.Decimal(18, 2)
  discountAmount       Decimal      @default(0) @db.Decimal(18, 2)
  serviceChargePercent Decimal      @default(0) @db.Decimal(5, 2)
  serviceChargeAmount  Decimal      @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal      @db.Decimal(18, 2)
  totalAmount          Decimal      @db.Decimal(18, 2)
  status         String       @default("CONFIRMED")
  deliveryStatus String       @default("PENDING")
  deliveredAt    DateTime?
  deliveredBy    String?
  deliveryNotes  String?
  notes          String?
  createdById    String
  createdByName  String
  isDemoData     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines            SalesOrderLine[]
  customerInvoices CustomerInvoice[]
}

model SalesOrderLine {
  id               String         @id @default(uuid())
  salesOrderId     String
  salesOrder       SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productServiceId String
  productService   ProductService @relation(fields: [productServiceId], references: [id])
  description      String
  quantity         Decimal        @db.Decimal(12, 2)
  unitPrice        Decimal        @db.Decimal(18, 2)
  discountAmount   Decimal        @default(0) @db.Decimal(18, 2)
  taxAmount        Decimal        @db.Decimal(18, 2)
  lineTotal        Decimal        @db.Decimal(18, 2)
}

model CustomerInvoice {
  id                    String       @id @default(uuid())
  docNumber             String       @unique
  salesOrderId          String?
  salesOrder            SalesOrder?  @relation(fields: [salesOrderId], references: [id])
  customerId            String
  customer              Customer     @relation(fields: [customerId], references: [id])
  businessUnitId        String
  businessUnit          BusinessUnit @relation(fields: [businessUnitId], references: [id])
  invoiceType           String       @default("PELUNASAN")
  activityTitle         String?
  activityDate          String?
  rincianLabel          String?
  revenueAccountCode    String?
  taxScheme             String       @default("PPN12_PMK131")
  taxInclusive          Boolean      @default(true)
  taxCollectorProfile   String       @default("FP_040_UMUM")
  fakturPajakCode       String       @default("040")
  issueDate             DateTime     @default(now())
  dueDate               DateTime
  subtotal              Decimal      @db.Decimal(18, 2)
  discountPercent       Decimal      @default(0) @db.Decimal(5, 2)
  discountAmount        Decimal      @default(0) @db.Decimal(18, 2)
  serviceChargePercent  Decimal      @default(0) @db.Decimal(5, 2)
  serviceChargeAmount   Decimal      @default(0) @db.Decimal(18, 2)
  nilaiJual             Decimal      @default(0) @db.Decimal(18, 2)
  dppPb1                Decimal      @default(0) @db.Decimal(18, 2)
  dppPpn                Decimal      @default(0) @db.Decimal(18, 2)
  dppPph                Decimal      @default(0) @db.Decimal(18, 2)
  ppnAmount             Decimal      @default(0) @db.Decimal(18, 2)
  pph42Amount           Decimal      @default(0) @db.Decimal(18, 2)
  pph23Amount           Decimal      @default(0) @db.Decimal(18, 2)
  pph23Rate15Amount     Decimal      @default(0) @db.Decimal(18, 2)
  pph21Amount           Decimal      @default(0) @db.Decimal(18, 2)
  pb1Amount             Decimal      @default(0) @db.Decimal(18, 2)
  dpPercent             Decimal      @default(0) @db.Decimal(5, 2)
  picName               String?
  subCategory           String?
  taxAmount             Decimal      @db.Decimal(18, 2)
  totalAmount           Decimal      @db.Decimal(18, 2)
  netReceivableAmount   Decimal      @default(0) @db.Decimal(18, 2)
  taxWithheldByCustomer Boolean      @default(false)
  paidAmount            Decimal      @default(0) @db.Decimal(18, 2)
  balanceDue            Decimal      @db.Decimal(18, 2)
  status                String       @default("ISSUED")
  approvalStatus        String       @default("APPROVED")
  approvedById          String?
  approvedByName        String?
  approvedAt            DateTime?
  rejectedById          String?
  rejectedByName        String?
  rejectedAt            DateTime?
  rejectionReason       String?
  lastRemindedAt        DateTime?
  reminderCount         Int          @default(0)
  serviceDelivered      Boolean      @default(false)
  bankAccountId         String?
  voidReason            String?
  voidedAt              DateTime?
  notes                 String?
  createdById           String
  createdByName         String
  isDemoData            Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  lines    CustomerInvoiceLine[]
  payments Payment[]
  refunds  Refund[]
}

model CustomerInvoiceLine {
  id                String          @id @default(uuid())
  customerInvoiceId String
  customerInvoice   CustomerInvoice @relation(fields: [customerInvoiceId], references: [id], onDelete: Cascade)
  description       String
  quantity          Decimal         @db.Decimal(12, 2)
  duration          Decimal         @default(1) @db.Decimal(12, 2)
  durationUnit      String?
  unitPrice         Decimal         @db.Decimal(18, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal         @db.Decimal(18, 2)
  lineTotal         Decimal         @db.Decimal(18, 2)
}

model Payment {
  id                  String           @id @default(uuid())
  receiptNumber       String           @unique
  receiptType         String           @default("KUITANSI")
  paymentStage        String           @default("PELUNASAN")
  customerInvoiceId   String?
  customerInvoice     CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id])
  businessUnitId      String?
  businessUnit        BusinessUnit?    @relation(fields: [businessUnitId], references: [id])
  customerId          String?
  customer            Customer?        @relation(fields: [customerId], references: [id])
