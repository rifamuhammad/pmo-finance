  "cards": [
    {
      "dot": "cyan",
      "title": "Lapisan Client & Antarmuka",
      "items": [
        "Aplikasi Single Page Vue 3 dengan tema Aivora Dark/Light System",
        "State management terpusat Pinia untuk otentikasi peran & unit bisnis aktif",
        "Komponen UI PrimeVue 5 responsif dan grafik interaktif native SVG"
      ]
    },
    {
      "dot": "emerald",
      "title": "Aturan Bisnis & Mesin Operasional",
      "items": [
        "Segregation of Duties (SoD): Pembuat draft tidak dapat menyetujui pengajuan sendiri",
        "Pencadangan Plafon (Budget Commitment) otomatis mencegah pengeluaran melebihi anggaran",
        "Validasi 3-Way Matching (PO vs Goods Receipt vs Faktur Vendor) sebelum pembayaran",
        "Posting otomatis Jurnal Berimbang (Double-Entry) ke Buku Besar saat transaksi cair"
      ]
    },
    {
      "dot": "rose",
      "title": "Keamanan & Kepatuhan Audit",
      "items": [
        "Matriks 9 Peran RBAC granular terotentikasi token JWT Bearer & Argon2",
        "Log Audit Server-Side yang tidak dapat dihapus (Immutable Audit Trail)",
        "Dukungan rekonsiliasi mutasi rekening bank dengan pendeteksian selisih fisik otomatis"
      ]
    }
  ]
