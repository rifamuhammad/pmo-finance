  "cards": [
    {
      "dot": "cyan",
      "title": "Pemisahan Wewenang (Segregation of Duties)",
      "items": [
        "Manager unit penyusun draft tidak dapat menyetujui anggaran atau PR miliknya sendiri",
        "Pengadaan bernilai >= Rp 25 Juta memerlukan eskalasi persetujuan ke GM PMO",
        "Auditor internal memiliki akses baca menyeluruh (Read-Only) tanpa hak mutasi data"
      ]
    },
    {
      "dot": "emerald",
      "title": "Integritas 3-Way Match & Pencadangan Plafon",
      "items": [
        "Saat PR disetujui, dana langsung dicadangkan (Budget Commitment) guna mencegah over-budget",
        "Wajib melampirkan minimal 3 penawaran vendor sebelum PO dapat diterbitkan",
        "Faktur rekanan diverifikasi otomatis terhadap kuantitas Goods Receipt yang benar-benar diterima"
      ]
    },
    {
      "dot": "rose",
      "title": "Disiplin Kasir POS & Rekonsiliasi Bank",
      "items": [
        "Setiap shift kasir wajib dibuka dengan hitung modal awal dan ditutup dengan berita acara fisik",
        "Selisih kas fisik melebihi toleransi Rp 50.000 wajib diajukan ke Finance Manager",
        "Mutasi rekening koran dicocokkan otomatis ke kuitansi pembayaran dan setoran kasir"
      ]
    }
