# Konfigurasi Environment ERP Keuangan & Operasional PMO UTama
# Salin file ini ke .env untuk pengembangan lokal. Jangan pernah commit secret produksi.

NODE_ENV=development
PORT=4000
TZ=Asia/Jakarta

# PostgreSQL Database Connection
DATABASE_URL="postgresql://syahbintang@localhost:5432/pmo_erp?schema=public"

# JWT & Security Configuration (Ganti di lingkungan produksi)
JWT_SECRET="dev-only-pmo-utama-jwt-secret-change-in-production-2026"
JWT_EXPIRES_IN="12h"
WEBHOOK_SHARED_SECRET="dev-only-webhook-hmac-secret-2026"

# CORS & Frontend URL
CORS_ORIGIN="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:4000/api/v1"

# File Upload Storage (Direktori privat di luar public web root)
STORAGE_DIR="./storage/private-uploads"
MAX_UPLOAD_SIZE_MB=10
